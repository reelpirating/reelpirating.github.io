   442	    /**
   443	     * Parse quality variants from HLS manifest
   444	     */
   445	    private parseVariants(
   446	        content: string
   447	    ): Array<{ resolution: number; url: string }> {
   448	        const variants: Array<{ resolution: number; url: string }> = [];
   449	        const regex =
   450	            /#EXT-X-STREAM-INF:[^\n]*RESOLUTION=\d+x(\d+)[^\n]*\n([^\n]+)/g;
   451	        let match;
   452	
   453	        while ((match = regex.exec(content)) !== null) {
   454	            variants.push({
   455	                resolution: parseInt(match[1], 10),
   456	                url: match[2]
   457	            });
   458	        }
   459	
   460	        return variants;
   461	    }
