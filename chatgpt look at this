   386	    /**
   387	     * Parse audio tracks from HLS manifest
   388	     */
   389	    private parseAudioTracks(
   390	        content: string
   391	    ): Array<{ language: string; label: string }> {
   392	        const tracks: Array<{ language: string; label: string }> = [];
   393	        const lines = content.split('\n');
   394	
   395	        for (const line of lines) {
   396	            if (!line.startsWith('#EXT-X-MEDIA:TYPE=AUDIO')) continue;
   397	
   398	            const language = line.match(/LANGUAGE="([^"]+)"/)?.[1] ?? 'unknown';
   399	            const label = line.match(/NAME="([^"]+)"/)?.[1] ?? 'Audio';
   400	
   401	            tracks.push({
   402	                language,
   403	                label
   404	            });
   405	        }
   406	
   407	        return tracks;
   408	    }
