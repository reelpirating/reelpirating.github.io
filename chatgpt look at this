   258	    /**
   259	     * Prefer English audio when the HLS master playlist provides it.
   260	     */
   261	    private preferEnglishAudio(content: string): string {
   262	        const lines = content.split(/\r?\n/);
   263	
   264	        const audio = lines
   265	            .map((line, index) => ({ line, index }))
   266	            .filter(x => x.line.startsWith("#EXT-X-MEDIA:TYPE=AUDIO"));
   267	
   268	        if (audio.length === 0) return content;
   269	
   270	        const isEnglish = (line: string): boolean => {
   271	            const lang =
   272	                line.match(/LANGUAGE="([^"]+)"/i)?.[1]?.toLowerCase() ?? "";
   273	            const name =
   274	                line.match(/NAME="([^"]+)"/i)?.[1]?.toLowerCase() ?? "";
   275	
   276	            return (
   277	                /^(en|eng|en-us|en-gb)(?:[-_].*)?$/.test(lang) ||
   278	                /\benglish\b/i.test(name) ||
   279	                /\boriginal\b/i.test(name)
   280	            );
   281	        };
   282	
   283	        const english = audio.find(x => isEnglish(x.line));
   284	
   285	        if (!english) return content;
   286	
   287	        const englishUri =
   288	            english.line.match(/URI="([^"]+)"/i)?.[1];
   289	
   290	        return lines.map(line => {
   291	            if (!line.startsWith("#EXT-X-MEDIA:TYPE=AUDIO")) {
   292	                return line;
   293	            }
   294	
   295	            const selected = isEnglish(line);
   296	
   297	            let out = line
   298	                .replace(/DEFAULT=(YES|NO)/i,
   299	                    `DEFAULT=${selected ? "YES" : "NO"}`)
   300	                .replace(/AUTOSELECT=(YES|NO)/i,
   301	                    `AUTOSELECT=${selected ? "YES" : "NO"}`);
   302	
   303	            if (!selected && englishUri) {
   304	                out = out.replace(
   305	                    /URI="[^"]+"/i,
   306	                    `URI="${englishUri}"`
   307	                );
   308	            }
   309	
   310	            return out;
   311	        }).join("\n");
   312	    }
