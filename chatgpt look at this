   317	    private parsePlaylist(
   318	        content: string,
   319	        masterUrl: string,
   320	        pageUrl: string,
   321	        media: ProviderMediaObject
   322	    ): ProviderResult {
   323	        const audioTracks = this.parseAudioTracks(content);
   324	        audioTracks.sort((a, b) => {
   325	            const score = (x: { language: string; label: string }) =>
   326	                /^en(?:[-_]|$)/i.test(x.language) || /\benglish\b/i.test(x.label) ? 0 : 1;
   327	            return score(a) - score(b);
   328	        });
   329	        audioTracks.sort((a, b) => {
   330	            const aEn = /^en(?:[-_]|$)/i.test(a.language) ? 0 : 1;
   331	            const bEn = /^en(?:[-_]|$)/i.test(b.language) ? 0 : 1;
   332	            return aEn - bEn;
   333	        });
   334	        const subtitles = this.parseSubtitles(content, pageUrl);
   335	        const variants = this.parseVariants(content);
   336	
   337	        if (variants.length === 0) {
   338	            return this.emptyResult('No streams found in playlist', media);
   339	        }
   340	
   341	        const bestVariant = variants.reduce((best, current) =>
   342	            current.resolution > best.resolution ? current : best
   343	        );
   344	
   345	        const sources: Source[] = [
   346	            {
   347	                url: this.createProxyUrl(masterUrl, {
   348	                    ...this.HEADERS,
   349	                    Referer: pageUrl
   350	                }),
   351	                type: 'hls',
   352	                quality: `${bestVariant.resolution}p`,
   353	                audioTracks:
   354	                    audioTracks.length > 0
   355	                        ? audioTracks
   356	                        : [
   357	                              {
   358	                                  language: 'en',
   359	                                  label: 'English'
   360	                              }
   361	                          ],
   362	                provider: {
   363	                    id: this.id,
   364	                    name: this.name
   365	                }
   366	            }
   367	        ];
   368	
   369	        return {
   370	            sources,
   371	            subtitles,
   372	            diagnostics:
   373	                sources.length === 0
   374	                    ? [
   375	                          {
   376	                              code: 'PARTIAL_SCRAPE',
   377	                              message: 'No playable streams found',
   378	                              field: 'sources',
   379	                              severity: 'warning'
   380	                          }
   381	                      ]
   382	                    : []
   383	        };
   384	    }
